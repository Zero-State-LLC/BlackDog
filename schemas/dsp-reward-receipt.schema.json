{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zero-State-LLC/FaustCoder/specs/001-faustcoder/contracts/DSPRewardReceipt.schema.json",
  "title": "DSPRewardReceipt",
  "description": "Spec §23 reward receipt. purpose is reward. grade_receipt rejects a diagnostic receipt against this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_sha256",
    "test_suite_digest",
    "sample_rate",
    "block_size",
    "seed",
    "metrics",
    "thresholds",
    "passed",
    "harness_digest",
    "purpose",
    "profile"
  ],
  "properties": {
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "test_suite_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sample_rate": {
      "type": "integer",
      "minimum": 1
    },
    "block_size": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "integer"
    },
    "metrics": {
      "type": "object",
      "required": ["comparison", "signed_frames", "frame_count", "head_frames"],
      "properties": {
        "comparison": {
          "const": "reward-graded-signed-full"
        },
        "signed_frames": {
          "type": "integer",
          "minimum": 1
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1
        },
        "head_frames": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "thresholds": {
      "type": "object",
      "required": ["reward_graded"],
      "properties": {
        "reward_graded": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "passed": {
      "type": "boolean"
    },
    "harness_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "renderer": {
      "type": "string",
      "enum": ["faustwasm", "native"]
    },
    "reference_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "purpose": {
      "const": "reward"
    },
    "profile": {
      "type": "object"
    }
  }
}
