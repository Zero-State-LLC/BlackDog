{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zero-State-LLC/FaustCoder/specs/001-faustcoder/contracts/DSPTestReceipt.schema.json",
  "title": "DSPTestReceipt",
  "description": "Spec §8 DSPTestReceipt (R-006). Fields renderer and reference_digest added in spec 0.3.0 (ADR-0004). purpose and profile added in spec 0.3.4 (ADR-0006, §23).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_sha256",
    "test_suite_digest",
    "sample_rate",
    "block_size",
    "seed",
    "metrics",
    "thresholds",
    "passed",
    "harness_digest",
    "purpose"
  ],
  "properties": {
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "test_suite_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sample_rate": {
      "type": "integer",
      "minimum": 1
    },
    "block_size": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "integer"
    },
    "metrics": {
      "type": "object"
    },
    "thresholds": {
      "type": "object"
    },
    "passed": {
      "type": "boolean"
    },
    "harness_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "renderer": {
      "type": "string",
      "enum": [
        "faustwasm",
        "native"
      ]
    },
    "reference_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "purpose": {
      "type": "string",
      "enum": ["diagnostic", "reward"]
    },
    "profile": {
      "type": "object"
    }
  }
}
