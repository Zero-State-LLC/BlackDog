{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned public instruction tokenizer preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "scope_digest",
    "public_pairs",
    "tokenizer"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "public-pair-tokenizer.v1"
    },
    "scope_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "public_pairs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "revision",
        "files"
      ],
      "properties": {
        "model": {
          "const": "Qwen/Qwen2.5-Coder-1.5B"
        },
        "revision": {
          "const": "df3ce67c0e24480f20468b6ef2894622d69eb73b"
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tokenizer.json",
            "tokenizer_config.json",
            "vocab.json",
            "merges.txt"
          ],
          "properties": {
            "tokenizer.json": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "tokenizer_config.json": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "vocab.json": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "merges.txt": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
