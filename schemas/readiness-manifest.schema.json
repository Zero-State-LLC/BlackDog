{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Readiness evidence index, not authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "scope_digest",
    "receipts"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "mode": {
      "enum": [
        "synthetic",
        "pilot",
        "full"
      ]
    },
    "scope_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receipts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt_id",
          "gate",
          "path",
          "sha256",
          "scope_digest",
          "outcome"
        ],
        "properties": {
          "receipt_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "gate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "scope_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "outcome": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          }
        }
      }
    }
  }
}
