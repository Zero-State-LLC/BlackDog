{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zero-State-LLC/FaustCoder/specs/001-faustcoder/contracts/TaskSpec.schema.json",
  "title": "TaskSpec",
  "description": "Spec §8 TaskSpec. Field types are INFERRED. category, target and remix_sources added in spec 0.3.0 (R-004, R-020).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_type",
    "prompt",
    "constraints",
    "expected_io",
    "test_profile",
    "schema_version"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "task_type": {
      "type": "string",
      "description": "generate, repair, explain, optimize, remix (R-004, 0.3.0)"
    },
    "prompt": {
      "type": "string"
    },
    "constraints": {
      "type": "object"
    },
    "expected_io": {
      "type": "object",
      "description": "INFERRED: input and output channel counts"
    },
    "test_profile": {
      "type": "object"
    },
    "schema_version": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "faustlibraries library name, for example oscillators, filters, reverbs"
    },
    "target": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_class",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "target_class": {
            "type": "string",
            "enum": [
              "host",
              "language",
              "plugin",
              "embedded",
              "fpga"
            ]
          },
          "target": {
            "type": "string",
            "description": "for example cpp, clap, vst3, lv2, daisy-seed, teensy41, ice40"
          }
        }
      }
    },
    "remix_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "minItems": 2
    }
  }
}
