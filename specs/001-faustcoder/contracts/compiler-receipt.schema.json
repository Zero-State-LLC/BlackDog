{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zero-State-LLC/FaustCoder/specs/001-faustcoder/contracts/CompilerReceipt.schema.json",
  "title": "CompilerReceipt",
  "description": "Spec §8 CompilerReceipt (R-005).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_sha256",
    "faust_version",
    "command",
    "exit_code",
    "stdout_digest",
    "stderr_digest",
    "duration_ms",
    "environment_digest"
  ],
  "properties": {
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "faust_version": {
      "type": "string"
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit_code": {
      "type": "integer"
    },
    "stdout_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stderr_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
