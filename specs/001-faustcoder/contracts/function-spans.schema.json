{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zero-State-LLC/BlackDog/specs/001-faustcoder/contracts/function-spans.schema.json",
  "title": "Reviewed function spans",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_digest",
    "notice_digest",
    "reviewer",
    "spans"
  ],
  "properties": {
    "schema_version": {
      "const": "function-spans.v1"
    },
    "inventory_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "notice_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "repo",
          "pin",
          "path",
          "blob_sha",
          "function",
          "start_byte",
          "end_byte",
          "sha256"
        ],
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "pin": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "blob_sha": {
            "type": "string",
            "minLength": 1
          },
          "function": {
            "type": "string",
            "minLength": 1
          },
          "start_byte": {
            "type": "integer",
            "minimum": 0
          },
          "end_byte": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
