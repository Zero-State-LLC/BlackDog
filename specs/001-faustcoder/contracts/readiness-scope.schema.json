{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Readiness run scope, not training authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "dataset_snapshot_digest",
    "code_revision",
    "model_digest",
    "recipe_digest"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "mode": {
      "enum": [
        "synthetic",
        "pilot",
        "full"
      ]
    },
    "dataset_snapshot_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "code_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "model_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "recipe_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
